# 复制成 .env 再填：cp .env.example .env

# ===== 必填：DeepSeek API Key =====
# 申请地址 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ===== 模型（一般不用改）=====
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TEMPERATURE=0.3
MAX_TOKENS=900

# ===== 检索 =====
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 向量化方式：default（零依赖，英文小模型）| st（本地中文模型）| openai（任意兼容接口）
EMBED_PROVIDER=default
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# EMBED_API_BASE=https://api.siliconflow.cn/v1
# EMBED_API_KEY=

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000

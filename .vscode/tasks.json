{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "增量更新索引",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/build_index.py --incremental",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "全量重建索引",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/build_index.py --full",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "抓取官网资料",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/crawl_dlufl.py",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "启动服务",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}

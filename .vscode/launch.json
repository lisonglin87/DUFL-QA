{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动服务（带热重载）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "启动服务（调试用，不带热重载）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "重建索引（全量）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_index.py",
      "args": ["--full"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
